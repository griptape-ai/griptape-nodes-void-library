{
    "name": "Griptape Nodes VOID Library",
    "library_schema_version": "0.12.0",
    "advanced_library_path": "void_library_advanced.py",
    "metadata": {
        "author": "Griptape, Inc.",
        "description": "VOID is a two-pass video inpainting model that removes objects from videos along with all interactions they induce on the scene -- not just secondary effects like shadows and reflections, but physical interactions such as objects falling when a supporting person is removed. Pass 1 generates a plausible inpainted video, and Pass 2 (optional) refines temporal consistency using warped-noise from the Pass 1 output.",
        "library_version": "0.5.0",
        "engine_version": "0.102.0",
        "tags": [
            "Griptape",
            "AI",
            "Video",
            "Inpainting",
            "ObjectRemoval"
        ],
